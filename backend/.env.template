# -----------------------------------------------------------------
# This template contains all required environment variables to set
# Visit the docs to find more information https://github.com/jiisanda/docflow/blob/master/app/docs/setup.md
# -----------------------------------------------------------------

# add only the database password if you want to run with the default postgres, otherwise change setting accordingly
DATABASE_HOSTNAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=docflow_db
POSTGRES_DB_TESTS=docflow_test_db

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

S3_BUCKET=docflow_s3
S3_TEST_BUCKET=docflow_test_s3

# Public address of the frontend — share links are built against it, so it must
# be reachable by the recipient (not localhost / a LAN address)
FRONTEND_URL=http://77.245.107.136:8080

# User Env
ACCESS_TOKEN_EXPIRE_MIN=3002
REFRESH_TOKEN_EXPIRE_MIN=30
ALGORITHM=<algorithm>

# random secret key, use python's secrets.token_urlsafe() or secrets.token_hex() to generate one
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Email Service
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Add email and apps password following the steps in docs https://github.com/jiisanda/docflow/blob/master/app/docs/setup.md
EMAIL=
APP_PASSWORD=<password_of_registered_app>
# ── OnlyOffice (document editing) ────────────────────────────────────────────
# Shared secret between this API and Document Server. It MUST match Document
# Server's JWT_SECRET: the save callback is rejected without a valid signature,
# so a mismatch (or an empty value) disables editing rather than silently
# accepting unsigned callbacks. There is no default — the previous one was a
# literal in source, which meant every deployment shared the same key.
ONLYOFFICE_JWT_SECRET=

# Where the browser loads the editor from.
DOCUMENT_SERVER_PUBLIC=http://localhost:8085

# This API's address as Document Server sees it. It fetches the document and
# posts the save callback here, so localhost only works if they share a host.
BACKEND_PUBLIC_URL=http://localhost:8000

# Срок действия доступа, если при шаринге не выбрали дату (в днях).
# Действует и на персональный доступ, и на публичную ссылку.
SHARE_EXPIRY_DAYS=3
